{
	"name": "amici/craft-super-pdf",
	"description": "Create PDF files from HTML and Twig templates",
	"version": "5.1.0",
	"type": "craft-plugin",
	"keywords": ["craft", "cms", "craftcms", "craft-plugin","pdf", "amici", "dompdf", "twig-to-pdf", "create-pdf"],
	"license": "proprietary",
	"authors": [
		{
			"name": "Amici Infotech",
			"homepage": "https://amiciinfotech.com"
		}
	],
	"support": {
		"email": "contact@amiciinfotech.com",
		"issues": "https://github.com/amici-infotech/craft-super-pdf/issues",
		"source": "https://github.com/amici-infotech/craft-super-pdf",
		"docs": "https://docs.amiciinfotech.com/craft-cms/super-pdf",
		"rss": "https://github.com/amici-infotech/craft-super-pdf/commits/craft-5.atom"
	},
	"require": {
		"php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
		"craftcms/cms": "^4.0 || ^5.0",
		"dompdf/dompdf": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"amici\\SuperPdf\\": "src/"
		}
	},
	"extra": {
		"handle": "super-pdf",
		"name": "Super PDF",
		"description": "Create PDF files from HTML and Twig templates",
		"developer": "Amici Infotech",
		"developerUrl": "https://amiciinfotech.com",
		"documentationUrl": "https://docs.amiciinfotech.com/craft-cms/super-pdf",
		"changelogUrl": "https://raw.githubusercontent.com/amici-infotech/craft-super-pdf/craft-5/CHANGELOG.md",
		"class": "amici\\SuperPdf\\Plugin"
	},
	"config": {
		"allow-plugins": {
			"yiisoft/yii2-composer": true,
			"craftcms/plugin-installer": true
		}
	}
}
