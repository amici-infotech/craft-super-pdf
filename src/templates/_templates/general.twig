{% extends 'super-pdf/_layouts/base' %}
{% set selectedSubnavItem = 'settings' %}
{% set title  = navigation[meta.selectedNav].label %}
{% import 'super-pdf/_macros' as macros %}
{% set readOnly = readOnly ?? meta.readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% macro errorList(errors) %}
    {% if errors %}
        <ul class="errors">
            {% for categorizedErrors in errors %}
                {% for error in categorizedErrors %}
                    <li>{{ error }}</li>
                {% endfor %}
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
{% from _self import errorList %}

{% import "_includes/forms" as forms %}
{% block content %}
	<div id="settings-cp">
		{% if errors is defined and errors|length %}
		    <div class="pane">
		        <h3>{{ "Something went wrong!"|t('super-pdf') }}</h3>
		        {{ errorList(errors) }}
		    </div>
		    <br>
		{% endif %}

        {% if not readOnly %}
	        {{ csrfInput() }}
	        <input type="hidden" name="action" value="{{ meta.action }}">
	        {{ redirectInput(meta.redirect) }}
        {% endif %}

		{% namespace 'settings' %}
			{{ forms.textField({
			    first: true,
			    label: "Plugin Name"|t('super-pdf'),
			    name: 'pluginName',
			    value: settings.pluginName,
			    required: true,
			    disabled: readOnly,
			    errors: (settings is defined ? settings.getErrors('pluginName') : null),
			    warning: macros.configWarning('pluginName', 'super-pdf'),
			}) }}

			{{ forms.lightswitchField({
			    label: 'Enable CP Section'|t('super-pdf'),
			    instructions: 'Whether to enable Super PDF in the main sidebar navigation.'|t('super-pdf'),
			    id: 'hasCpSection',
			    name: 'hasCpSection',
			    on: settings.hasCpSection,
			    disabled: readOnly,
			    errors: (settings is defined ? settings.getErrors('hasCpSection') : null),
			    warning: macros.configWarning('hasCpSection', 'super-pdf'),
			}) }}

            <hr>

            {{ forms.selectField({
                label: "Default PDF Storage Volume"|t('super-pdf'),
                instructions: 'Default Folder where PDF files will store.'|t('super-pdf'),
                id: 'volume',
                name: 'volume',
                options: meta.sources,
                value: settings.volume,
                required: true,
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('volume') : null),
                warning: macros.configWarning('volume', 'super-pdf'),
            }) }}

            {{ forms.textField({
                label: "Sub Folder"|t('super-pdf'),
                name: 'folder',
                value: settings.folder,
                required: false,
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('folder') : null),
                warning: macros.configWarning('folder', 'super-pdf'),
            }) }}

            {{ forms.selectField({
                label: "Reset Behaviour"|t('super-pdf'),
                instructions: 'Default behaviour when file with the same name already exists.'|t('super-pdf'),
                id: 'resaveBehaviour',
                name: 'resaveBehaviour',
                options: [{
                    'label': 'Duplicate',
                    'value': 'duplicate'
                }, {
                    'label': 'Override',
                    'value': 'override'
                }, {
                    'label': 'Ignore',
                    'value': 'ignore'
                }],
                value: settings.resaveBehaviour,
                required: true,
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('resaveBehaviour') : null),
                warning: macros.configWarning('resaveBehaviour', 'super-pdf'),
            }) }}

            {{ forms.textField({
                label: "Entry PDF Template"|t('super-pdf'),
                instructions: 'Twig template used by the Download PDF entry action. Leave blank to hide the action. See docs for template tips.'|t('super-pdf'),
                tip: 'Use a minimal HTML document template (not a CP layout). Console smoke test: php craft super-pdf/generate --template=your/template --filename=test'|t('super-pdf'),
                id: 'entryPdfTemplate',
                name: 'entryPdfTemplate',
                value: settings.entryPdfTemplate,
                placeholder: 'pdf/entry',
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('entryPdfTemplate') : null),
                warning: macros.configWarning('entryPdfTemplate', 'super-pdf'),
            }) }}

            {{ forms.textField({
                label: "Signed URL Expiry (seconds)"|t('super-pdf'),
                instructions: 'How long storage PDF download links remain valid when signatures are used. See Security docs.'|t('super-pdf'),
                tip: 'Enable “Require signed storage URLs” only after clients can use signed links.'|t('super-pdf'),
                id: 'signedUrlExpiry',
                name: 'signedUrlExpiry',
                value: settings.signedUrlExpiry,
                type: 'number',
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('signedUrlExpiry') : null),
                warning: macros.configWarning('signedUrlExpiry', 'super-pdf'),
            }) }}

            {{ forms.lightswitchField({
                label: 'Require signed storage URLs'|t('super-pdf'),
                instructions: 'When enabled, /super-pdf/{file} links must include a valid signature. Leave off to keep legacy unsigned links working.'|t('super-pdf'),
                id: 'requireSignedUrls',
                name: 'requireSignedUrls',
                on: settings.requireSignedUrls,
                disabled: readOnly,
                errors: (settings is defined ? settings.getErrors('requireSignedUrls') : null),
                warning: macros.configWarning('requireSignedUrls', 'super-pdf'),
            }) }}
		{% endnamespace %}

        {% if not readOnly %}
		    <button class="btn submit" type="submit">{{ 'Save'|t('super-pdf') }}</button>
        {% endif %}
    </div>
{% endblock %}
